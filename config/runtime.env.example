# Copy outside Git and configure the desired channel.
# Put CLI_PROXY_API_KEY in the private instance Secret, never in Git.
# Dashboard requires an auth provider for its non-loopback bind.
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=...
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=...
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=...
# HERMES_DASHBOARD_PUBLIC_URL=https://hermes-your-instance.your-tailnet.ts.net
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_ALLOWED_USERS=...
# DISCORD_BOT_TOKEN=...
# WHATSAPP_ENABLED=true
