# Installer configuration. Copy to .env and chmod 600 .env. Never source this file.
# Relative file paths are resolved against the private instance directory.
# This is NOT a native Hermes profile .env; profiles remain independent.
ASSISTANT_NAME=Hermes
KUBERNETES_NAMESPACE=hermes
KUBERNETES_CONTEXT=
TIMEZONE=UTC
MODEL=replace-with-your-model
MODEL_BASE_URL=http://cli-proxy-api.proxy.svc.cluster.local:8317/v1
MODEL_API_KEY=
# Optional native channel/integration variables, one independent file per profile.
RUNTIME_ENV_FILE=
DASHBOARD_TOKEN=
STATE_STORAGE_CLASS=
STATE_SIZE=10Gi
# external: explicitly allowed outbound TCP 80/443 (Drive, channels, HTTPS MCPs).
# restricted: only the SSH and model destinations below; add API_EGRESS_CIDRS as needed.
INTERNET_EGRESS=restricted
API_EGRESS_CIDRS=
MODEL_EGRESS_CIDRS=
MODEL_SERVICE_NAMESPACE=proxy
MODEL_SERVICE_SELECTOR=app.kubernetes.io/name=cli-proxy-api

# existing | lxc | vm. New guests use a fixed address and separate admin/runtime keys.
TERMINAL_KIND=existing
TERMINAL_HOST=
TERMINAL_PORT=22
TERMINAL_USER=hermes
TERMINAL_UID=10000
TERMINAL_WORKSPACE=/home/hermes/.hermes
# Terminal folders the file tools may write to, besides the pod state; comma-separated
# absolute paths. Empty keeps the image default (pod state only).
TERMINAL_WRITE_ROOTS=
TERMINAL_EGRESS_CIDRS=
# Existing terminal: authorize this key yourself; pin its host key in this file.
TERMINAL_SSH_KEY_FILE=
TERMINAL_KNOWN_HOSTS_FILE=
# Git access is optional; use a dedicated read/write deploy key for this instance.
INSTANCE_REPOSITORY=
GIT_SSH_KEY_FILE=
GIT_KNOWN_HOSTS_FILE=

# Managed Proxmox guests only. Credentials are read from private files.
PROXMOX_ENDPOINT=
PROXMOX_NODE=
PROXMOX_GUEST_ID=
PROXMOX_API_TOKEN_FILE=
# LXC FUSE/keyctl require root@pam password authentication.
PROXMOX_ROOT_PASSWORD_FILE=
PROXMOX_TLS_VERIFY=true
PROXMOX_SSH_HOST=
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY_FILE=
PROXMOX_KNOWN_HOSTS_FILE=
PROXMOX_ROOT_STORAGE=
PROXMOX_TEMPLATE_STORAGE=
PROXMOX_BRIDGE=vmbr0
PROXMOX_VLAN=
TERMINAL_IPV4_CIDR=
TERMINAL_GATEWAY=
TERMINAL_CORES=4
TERMINAL_MEMORY_MIB=8192
TERMINAL_DISK_GIB=32
# VM only: an Ubuntu cloud-init template with Python, sudo and QEMU guest agent.
PROXMOX_VM_TEMPLATE_ID=

# Managed guests require an existing, dedicated CephFS subvolume/client.
# Its data is outside OpenTofu's disposable OS disk. Never use client.admin.
WORKSPACE_CEPH_MONITORS=
WORKSPACE_CEPH_FILESYSTEM=
WORKSPACE_CEPH_SUBVOLUME=
WORKSPACE_CEPH_CLIENT=
WORKSPACE_CEPH_KEY_FILE=

# Optional encrypted Google Drive backups. OAuth is a one-time browser step.
BACKUP_ENABLED=false
DRIVE_OAUTH_CLIENT_FILE=
DRIVE_RCLONE_CONFIG_FILE=.local/credentials/rclone.conf
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=6
# State and selected peripheral workspace paths only; no whole-home/cache backup.
# Additional literal paths relative to TERMINAL_WORKSPACE, comma-separated.
BACKUP_EXTRA_PATHS=
