@@ -0,0 +1,58 @@
+"""Catalog discovery must survive profile switches and long cold scans without needless rescans."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from tools import skills_tool as skills
+
+
+@pytest.fixture
+def catalog(monkeypatch, tmp_path):
+    roots = []
+    for name in ("one", "two"):
+        root = tmp_path / name
+        skill = root / name / "SKILL.md"
+        skill.parent.mkdir(parents=True)
+        skill.write_text(f"---\nname: {name}\ndescription: {name}\n---\nBody\n")
+        roots.append(root)
+    active = [roots[0]]
+    monkeypatch.setattr(skills, "_skill_search_dirs", lambda: ([(1, active[0])], active[0]))
+    monkeypatch.setattr(skills, "_get_disabled_skill_names", lambda: set())
+    monkeypatch.setattr(skills, "_SKILLS_CACHE", {})
+    return roots, active
+
+
+def test_alternating_profiles_reuse_their_own_catalogs(catalog, monkeypatch):
+    roots, active = catalog
+    read = skills._read_skill_text
+    reads = []
+
+    def counted(path):
+        reads.append(path)
+        return read(path)
+
+    monkeypatch.setattr(skills, "_read_skill_text", counted)
+    assert skills._skill_catalog()[0]["name"] == "one"
+    active[0] = roots[1]
+    assert skills._skill_catalog()[0]["name"] == "two"
+    active[0] = roots[0]
+    assert skills._skill_catalog()[0]["name"] == "one"
+    assert len(reads) == 2
+
+
+def test_slow_scan_does_not_publish_an_already_expired_catalog(catalog, monkeypatch):
+    clock = [0.0]
+    monkeypatch.setattr(skills, "time", SimpleNamespace(monotonic=lambda: clock[0]))
+    read = skills._read_skill_text
+    reads = []
+
+    def slow(path):
+        reads.append(path)
+        clock[0] += skills._SKILLS_CACHE_TTL_SECONDS + 1
+        return read(path)
+
+    monkeypatch.setattr(skills, "_read_skill_text", slow)
+    assert skills._skill_catalog()[0]["name"] == "one"
+    assert skills._skill_catalog()[0]["name"] == "one"
+    assert len(reads) == 1
