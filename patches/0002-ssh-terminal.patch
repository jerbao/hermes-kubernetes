+"""A shared SSH account must keep named profiles' file sync independent."""
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from tools.environments.ssh import SSHEnvironment
+
+
+class ShellSSH(SSHEnvironment):
+    def __init__(self, remote):
+        self.remote = remote
+        super().__init__('local-test-transport', 'fixture')
+
+    def _establish_connection(self):
+        pass
+
+    def _detect_remote_home(self):
+        return str(self.remote)
+
+    def _build_ssh_command(self, **kwargs):
+        return ['bash', '-c']
+
+    def _run_ssh(self, command, timeout=10):
+        return subprocess.run(['bash', '-c', command], capture_output=True, text=True, timeout=timeout)
+
+    def init_session(self):
+        pass
+
+    def _control_sockets(self):
+        return []
+
+
+def seed(home, value):
+    (home / 'skills/owned').mkdir(parents=True)
+    (home / 'config.yaml').write_text('terminal: {backend: ssh, sync_back_scope: mapped}\n')
+    (home / 'skills/owned/SKILL.md').write_text(value)
+
+
+@pytest.mark.platforms('linux')
+def test_named_profiles_keep_same_named_skills_and_cleanup_in_the_owning_scope(tmp_path, monkeypatch):
+    root = tmp_path / 'host/.hermes'
+    remote = tmp_path / 'vm'
+    remote.mkdir()
+    monkeypatch.setenv('HOME', str(root.parent))
+    monkeypatch.setenv('HERMES_HOME', str(root))
+    monkeypatch.setattr(Path, 'home', lambda: root.parent)
+    seed(root, 'root untouched')
+    profiles = [root / 'profiles/lima', root / 'profiles/pesquisa']
+    environments = []
+    for home in profiles:
+        seed(home, home.name)
+        token = set_hermes_home_override(home)
+        try:
+            environments.append(ShellSSH(remote))
+        finally:
+            reset_hermes_home_override(token)
+    for home in profiles:
+        target = remote / '.hermes/profiles' / home.name / 'skills/owned/SKILL.md'
+        assert target.read_text() == home.name
+        target.write_text('returned-' + home.name)
+    # A cleanup callback may run while a different profile is active.
+    token = set_hermes_home_override(profiles[1])
+    try:
+        environments[0].cleanup()
+    finally:
+        reset_hermes_home_override(token)
+    environments[1].cleanup()
+    assert (root / 'skills/owned/SKILL.md').read_text() == 'root untouched'
+    for home in profiles:
+        assert (home / 'skills/owned/SKILL.md').read_text() == 'returned-' + home.name
+    assert not (remote / '.hermes/skills/owned/SKILL.md').exists()
+
+
+@pytest.mark.platforms('linux')
+def test_default_profile_keeps_the_original_remote_home(tmp_path, monkeypatch):
+    root = tmp_path / 'host/.hermes'
+    remote = tmp_path / 'vm'
+    remote.mkdir()
+    monkeypatch.setenv('HOME', str(root.parent))
+    monkeypatch.setenv('HERMES_HOME', str(root))
+    monkeypatch.setattr(Path, 'home', lambda: root.parent)
+    seed(root, 'root')
+    environment = ShellSSH(remote)
+    target = remote / '.hermes/skills/owned/SKILL.md'
+    assert target.read_text() == 'root'
+    target.write_text('returned-root')
+    environment.cleanup()
+    assert (root / 'skills/owned/SKILL.md').read_text() == 'returned-root'
