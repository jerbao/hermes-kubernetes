@@ -0,0 +1,57 @@
+"""Large skill collections must fit SSH exec limits without losing files."""
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from tools.environments.ssh import SSHEnvironment
+
+
+@pytest.fixture
+def shell_environment(tmp_path):
+    remote_home = tmp_path / 'remote'
+    (remote_home / '.hermes').mkdir(parents=True)
+    environment = SSHEnvironment.__new__(SSHEnvironment)
+    environment.host = 'local-test'
+    environment._remote_home = str(remote_home)
+    environment._build_ssh_command = lambda: ['bash', '-c']
+
+    def run(command, timeout):
+        # A remote command is one argv string; Linux caps each string at 128 KiB.
+        # Leave room for SSH options and UTF-8 expansion on other hosts as well.
+        assert len(command.encode('utf-8')) <= 32768
+        return subprocess.run(['bash', '-c', command], timeout=timeout,
+                              capture_output=True, text=True)
+
+    environment._run_ssh = run
+    return environment
+
+
+def paths(environment):
+    base = Path(environment._remote_home) / '.hermes' / 'skills'
+    return [str(base / (f"skill {i:04d} ' ação " + 'x' * 90) / 'SKILL.md')
+            for i in range(1800)]
+
+
+@pytest.mark.platforms('posix')
+def test_large_bulk_upload_preserves_every_file(shell_environment, tmp_path):
+    source = tmp_path / 'content'
+    content = b'large-skill-collection\x00\xff'
+    source.write_bytes(content)
+    destinations = paths(shell_environment)
+    shell_environment._ssh_bulk_upload([(str(source), p) for p in destinations])
+    assert all(Path(p).read_bytes() == content for p in destinations)
+
+
+@pytest.mark.platforms('posix')
+def test_large_delete_removes_only_requested_files(shell_environment):
+    destinations = paths(shell_environment)
+    for name in destinations:
+        target = Path(name)
+        target.parent.mkdir(parents=True)
+        target.write_bytes(b'old')
+    retained = Path(shell_environment._remote_home) / '.hermes' / 'keep.txt'
+    retained.write_bytes(b'keep')
+    shell_environment._ssh_delete(destinations)
+    assert all(not Path(p).exists() for p in destinations)
+    assert retained.read_bytes() == b'keep'
