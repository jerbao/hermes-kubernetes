@@ -0,0 +1,162 @@
+"""SSH return archives preserve the native mapping without copying installations."""
+import tarfile
+
+import pytest
+
+from tools.environments import file_sync, ssh
+from tools.environments.file_sync import FileSyncManager
+
+
+def environment(root, manager):
+    result = ssh.SSHEnvironment.__new__(ssh.SSHEnvironment)
+    result.host = "fixture"
+    result._remote_home = str(root.parent)
+    result._sync_manager = manager
+    result._build_ssh_command = lambda *args, **kwargs: ["bash", "-c"]
+    return result
+
+
+def setup_manager(home, remote, monkeypatch):
+    (home / "skills").mkdir(parents=True)
+    (home / "cache").mkdir()
+    credential = home / "credential"
+    credential.write_text("local-private-fixture")
+    (home / "skills/index.md").write_text("local index")
+    (home / "cache/index.md").write_text("local cache")
+    mapping = [(str(home / "skills/index.md"), str(remote / "skills/index.md")),
+               (str(home / "cache/index.md"), str(remote / "cache/index.md")),
+               (str(credential), str(remote / "credential"))]
+    monkeypatch.setattr(file_sync, "_credential_host_paths", lambda: {str(credential.resolve())})
+    manager = FileSyncManager(lambda: mapping, lambda *args: None, lambda *args: None)
+    backend = environment(remote, manager)
+    manager._bulk_download_fn = backend._ssh_bulk_download
+    return manager, backend
+
+
+@pytest.mark.platforms("linux")
+def test_mapped_return_matches_full_return_with_new_files_and_relative_link_dependencies(tmp_path, monkeypatch):
+    from hermes_cli import config
+
+    remote = tmp_path / "remote/.hermes"
+    (remote / "skills/new/references").mkdir(parents=True)
+    (remote / "cache").mkdir()
+    (remote / "hermes-agent").mkdir()
+    (remote / "skills/index.md").write_text("remote index")
+    (remote / "skills/new/SKILL.md").write_text("new skill")
+    (remote / "skills/new/references/binary").write_bytes(bytes(range(256)) * 32)
+    (remote / "cache/index.md").write_text("remote cache")
+    (remote / "cache/new.data").write_bytes(b"new cache data")
+    (remote / "credential").write_text("remote must not replace credential")
+    (remote / "hermes-agent/documents").mkdir()
+    (remote / "hermes-agent/documents/reference.txt").write_text("relative dependency")
+    (remote / "hermes-agent/reference-dir").symlink_to("documents", target_is_directory=True)
+    (remote / "skills/reference.txt").symlink_to("../hermes-agent/reference-dir/reference.txt")
+    (remote / "hermes-agent/installation.bin").write_bytes(b"installation" * 10000)
+    states, sizes = {}, {}
+    for scope in ("full", "mapped"):
+        home = tmp_path / scope
+        manager, backend = setup_manager(home, remote, monkeypatch)
+        monkeypatch.setattr(config, "load_config_readonly", lambda: {"terminal": {"sync_back_scope": scope}})
+        archive = tmp_path / (scope + ".tar")
+        backend._ssh_bulk_download(archive)
+        sizes[scope] = archive.stat().st_size
+        manager._sync_back_impl()
+        states[scope] = {str(p.relative_to(home)): p.read_bytes() for p in home.rglob("*") if p.is_file()}
+        assert states[scope]["credential"] == b"local-private-fixture"
+        assert states[scope]["skills/new/SKILL.md"] == b"new skill"
+        assert states[scope]["skills/reference.txt"] == b"relative dependency"
+        assert states[scope]["cache/new.data"] == b"new cache data"
+    assert states["mapped"] == states["full"]
+    assert sizes["mapped"] < sizes["full"]
+    with tarfile.open(tmp_path / "mapped.tar") as archive:
+        assert not any(e.name.endswith("installation.bin") for e in archive)
+
+
+@pytest.mark.platforms("linux")
+def test_mapped_return_keeps_unmapped_venv_on_remote_and_rejects_mapped_escaping_link(tmp_path, monkeypatch):
+    from hermes_cli import config
+
+    remote = tmp_path / "remote/.hermes"
+    (remote / "skills").mkdir(parents=True)
+    (remote / "cache").mkdir()
+    (remote / "hermes-agent/.venv/bin").mkdir(parents=True)
+    (remote / "hermes-agent/.venv/bin/python").symlink_to("/usr/bin/python3")
+    (remote / "skills/index.md").write_text("remote skill")
+    (remote / "cache/index.md").write_text("cache")
+    (remote / "credential").write_text("fixture")
+    home = tmp_path / "host"
+    manager, backend = setup_manager(home, remote, monkeypatch)
+    monkeypatch.setattr(config, "load_config_readonly", lambda: {"terminal": {"sync_back_scope": "mapped"}})
+    manager._sync_back_impl()
+    assert (home / "skills/index.md").read_text() == "remote skill"
+    assert (remote / "hermes-agent/.venv/bin/python").is_symlink()
+    assert not (home / "hermes-agent").exists()
+    before = (home / "skills/index.md").read_bytes()
+    (remote / "skills/index.md").write_text("must not be partially applied")
+    (remote / "skills/escape").symlink_to("/etc/passwd")
+    with pytest.raises(tarfile.FilterError):
+        manager._sync_back_impl()
+    assert (home / "skills/index.md").read_bytes() == before
+
+
+@pytest.mark.platforms("linux")
+def test_return_uses_one_mapping_snapshot_and_does_not_follow_external_directory(tmp_path, monkeypatch):
+    from hermes_cli import config
+
+    remote = tmp_path / "remote/.hermes"
+    (remote / "cache").mkdir(parents=True)
+    (remote / "cache/index.md").write_text("cache")
+    external = tmp_path / "external"
+    external.mkdir()
+    (external / "index.md").write_text("must not be transported")
+    (remote / "skills").symlink_to(external, target_is_directory=True)
+    home = tmp_path / "host"
+    manager, backend = setup_manager(home, remote, monkeypatch)
+    mapping = manager._get_files_fn()
+    calls = []
+
+    def enumerate_once():
+        calls.append(True)
+        assert len(calls) == 1
+        return mapping
+
+    manager._get_files_fn = enumerate_once
+    monkeypatch.setattr(config, "load_config_readonly", lambda: {"terminal": {"sync_back_scope": "mapped"}})
+    with pytest.raises(tarfile.FilterError):
+        manager._sync_back_impl()
+    assert len(calls) == 1
+    assert manager._return_file_mapping is None
+    assert (home / "skills/index.md").read_text() == "local index"
+
+
+@pytest.mark.platforms("linux")
+def test_unmapped_external_directory_link_stays_on_vm_without_breaking_file_return(tmp_path, monkeypatch):
+    from hermes_cli import config
+
+    remote = tmp_path / "remote/.hermes"
+    (remote / "skills").mkdir(parents=True)
+    (remote / "cache").mkdir()
+    external = remote.parent / "external"
+    external.mkdir()
+    (external / "private.txt").write_text("external fixture must not be copied")
+    (remote / "skills/directory").symlink_to("../../external", target_is_directory=True)
+    (remote / "skills/index.md").write_text("returned index")
+    (remote / "cache/index.md").write_text("cache")
+    home = tmp_path / "host"
+    manager, backend = setup_manager(home, remote, monkeypatch)
+    monkeypatch.setattr(config, "load_config_readonly", lambda: {"terminal": {"sync_back_scope": "mapped"}})
+    manager._sync_back_impl()
+    assert (home / "skills/index.md").read_text() == "returned index"
+    assert not (home / "skills/directory").exists()
+    assert (remote / "skills/directory/private.txt").read_text() == "external fixture must not be copied"
+    # A materialized skill in the host snapshot explicitly maps this branch.
