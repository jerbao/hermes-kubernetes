@@ -0,0 +1,201 @@
+"""A new environment on a persistent host uploads only what the host lacks, and keeps progress."""
+import hashlib
+import os
+import subprocess
+import tarfile
+from pathlib import Path
+
+import pytest
+
+from tools.environments import file_sync
+from tools.environments.file_sync import FileSyncManager
+from tools.environments.ssh import SSHEnvironment
+
+
+def host_files(tmp_path, count):
+    files = []
+    for index in range(count):
+        path = tmp_path / "home" / "skills" / f"s{index}" / "SKILL.md"
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(f"skill {index}")
+        files.append((str(path), f"/remote/.hermes/skills/s{index}/SKILL.md"))
+    return files
+
+
+def stat_of(host_path, written_after=60.0):
+    """The state of a remote copy of *host_path* written *written_after* seconds after its last change."""
+    info = os.stat(host_path)
+    return info.st_size, int(info.st_mtime), info.st_ctime + written_after
+
+
+def manager_for(files, uploaded, remote_state=None):
+    return FileSyncManager(get_files_fn=lambda: files, upload_fn=lambda *args: None, delete_fn=lambda paths: None,
+                           bulk_upload_fn=lambda batch: uploaded.extend(remote for _, remote in batch),
+                           remote_state_fn=remote_state)
+
+
+def test_new_environment_uploads_only_files_the_remote_lacks(tmp_path):
+    files = host_files(tmp_path, 3)
+    remote = {remote: stat_of(host) for host, remote in files[:2]}
+    uploaded = []
+    manager = manager_for(files, uploaded, lambda paths: {p: remote[p] for p in paths if p in remote})
+
+    manager.sync(force=True)
+
+    assert uploaded == [files[2][1]]
+    host, remote_path = files[0]
+    assert manager._pushed_hashes[remote_path] == hashlib.sha256(Path(host).read_bytes()).hexdigest()
+    assert set(manager.remote_file_state()) == {remote for _, remote in files}
+    uploaded.clear()
+    manager.sync(force=True)
+    assert uploaded == []
+
+
+def test_remote_copy_with_other_size_or_mtime_is_uploaded(tmp_path):
+    files = host_files(tmp_path, 2)
+    size, mtime, ctime = stat_of(files[0][0])
+    remote = {files[0][1]: (size, mtime - 5, ctime), files[1][1]: (size + 1, mtime, ctime)}
+    uploaded = []
+    manager_for(files, uploaded, lambda paths: remote).sync(force=True)
+    assert sorted(uploaded) == sorted(remote)
+
+
+def test_host_file_replaced_after_the_remote_copy_is_uploaded(tmp_path):
+    files = host_files(tmp_path, 1)
+    host, remote_path = files[0]
+    uploaded = []
+    manager_for(files, uploaded, lambda paths: {remote_path: stat_of(host, written_after=-60.0)}).sync(force=True)
+    assert uploaded == [remote_path]
+
+
+def test_unavailable_remote_state_uploads_every_file(tmp_path):
+    files = host_files(tmp_path, 2)
+    uploaded = []
+
+    def broken(paths):
+        raise RuntimeError("python3: command not found")
+
+    manager_for(files, uploaded, broken).sync(force=True)
+    assert len(uploaded) == 2
+
+
+def test_failed_batch_keeps_earlier_batches(tmp_path, monkeypatch):
+    monkeypatch.setattr(file_sync, "_UPLOAD_BATCH_FILES", 2)
+    files = host_files(tmp_path, 5)
+    sent, failures = [], [RuntimeError("SSH bulk upload timed out")]
+
+    def flaky(batch):
+        if len(sent) == 4 and failures:
+            raise failures.pop()
+        sent.extend(remote for _, remote in batch)
+
+    manager = FileSyncManager(get_files_fn=lambda: files, upload_fn=lambda *args: None,
+                              delete_fn=lambda paths: None, bulk_upload_fn=flaky)
+    manager.sync(force=True)
+    assert len(sent) == 4
+
+    manager.sync(force=True)
+    assert sent[4:] == [files[4][1]]
+
+
+@pytest.fixture
+def shell_environment(tmp_path):
+    remote_home = tmp_path / "remote"
+    (remote_home / ".hermes").mkdir(parents=True)
+    environment = SSHEnvironment.__new__(SSHEnvironment)
+    environment.host = "local-test"
+    environment._remote_home = str(remote_home)
+    environment._build_ssh_command = lambda *args, **kwargs: ["bash", "-c"]
+    environment._run_ssh = lambda command, timeout: subprocess.run(
+        ["bash", "-c", command], timeout=timeout, capture_output=True, text=True)
+    return environment
+
+
+@pytest.mark.platforms("posix")
+def test_remote_state_lists_only_existing_regular_files(shell_environment):
+    base = Path(shell_environment._remote_home) / ".hermes"
+    (base / "a.md").write_text("abc")
+    (base / "link.md").symlink_to("a.md")
+    state = shell_environment._ssh_remote_state([str(base / name) for name in ("a.md", "link.md", "missing.md")])
+    info = (base / "a.md").stat()
+    assert state == {str(base / "a.md"): (3, int(info.st_mtime), info.st_ctime)}
+
+
+@pytest.mark.platforms("linux")
+def test_second_environment_adopts_what_the_first_uploaded(shell_environment, tmp_path, monkeypatch):
+    monkeypatch.setattr(file_sync, "_ADOPT_CLOCK_MARGIN_S", 0.0)
+    base = Path(shell_environment._remote_home) / ".hermes"
+    files = [(host, remote.replace("/remote/.hermes", str(base))) for host, remote in host_files(tmp_path, 3)]
+    for _, remote in files:
+        assert not Path(remote).exists()
+
+    def environment_manager(upload):
+        return FileSyncManager(get_files_fn=lambda: files, upload_fn=lambda *args: None,
+                               delete_fn=lambda paths: None, bulk_upload_fn=upload,
+                               remote_state_fn=shell_environment._ssh_remote_state)
+
+    environment_manager(shell_environment._ssh_bulk_upload).sync(force=True)
+    assert all(Path(remote).read_bytes() == Path(host).read_bytes() for host, remote in files)
+
+    uploaded = []
+    environment_manager(lambda batch: uploaded.extend(batch)).sync(force=True)
+    assert uploaded == []
+
+
+@pytest.mark.platforms("posix")
+def test_mapped_return_leaves_out_files_unchanged_since_sync(shell_environment, tmp_path, monkeypatch):
+    from hermes_cli import config
+
+    monkeypatch.setattr(file_sync, "_ADOPT_CLOCK_MARGIN_S", 0.0)
+
+    base = Path(shell_environment._remote_home) / ".hermes"
+    (base / "skills").mkdir()
+    home = tmp_path / "home"
+    (home / "skills").mkdir(parents=True)
+    mapping = []
+    for name in ("same.md", "edited.md"):
+        (home / "skills" / name).write_text("host " + name)
+        remote = base / "skills" / name
+        remote.write_text("host " + name)
+        info = (home / "skills" / name).stat()
+        os.utime(remote, ns=(info.st_atime_ns, info.st_mtime_ns))
+        mapping.append((str(home / "skills" / name), str(remote)))
+    manager = FileSyncManager(lambda: mapping, lambda *args: None, lambda *args: None,
+                              remote_state_fn=shell_environment._ssh_remote_state)
+    manager.sync(force=True)
+    shell_environment._sync_manager = manager
+    (base / "skills/edited.md").write_text("edited on the remote")
+    (base / "skills/new.md").write_text("created on the remote")
+    monkeypatch.setattr(config, "load_config_readonly", lambda: {"terminal": {"sync_back_scope": "mapped"}})
+
+    archive = tmp_path / "return.tar"
+    shell_environment._ssh_bulk_download(archive)
+
+    with tarfile.open(archive) as tar:
+        names = {Path(member.name).name for member in tar if member.isfile()}
+    assert names == {"edited.md", "new.md"}
+
+
+@pytest.mark.platforms("posix")
+def test_mapped_return_skips_skill_trees_the_upload_never_sends(shell_environment, tmp_path, monkeypatch):
+    from hermes_cli import config
+
+    base = Path(shell_environment._remote_home) / ".hermes"
+    for relative in ("skills/.curator_backups/old.tar.gz", "skills/.hub/lock.json",
+                     "skills/tool/node_modules/dep/index.js", "skills/tool/scripts/new.py", "cache/web/.git/page"):
+        (base / relative).parent.mkdir(parents=True, exist_ok=True)
+        (base / relative).write_text("remote")
+    home = tmp_path / "home"
+    for relative in ("skills/tool/SKILL.md", "cache/web/page.md"):
+        (home / relative).parent.mkdir(parents=True, exist_ok=True)
+        (home / relative).write_text("host")
+    mapping = [(str(home / r), str(base / r)) for r in ("skills/tool/SKILL.md", "cache/web/page.md")]
+    shell_environment._sync_manager = FileSyncManager(lambda: mapping, lambda *args: None, lambda *args: None)
+    monkeypatch.setattr(config, "load_config_readonly", lambda: {"terminal": {"sync_back_scope": "mapped"}})
+
+    archive = tmp_path / "return.tar"
+    shell_environment._ssh_bulk_download(archive)
+
+    with tarfile.open(archive) as tar:
+        names = {member.name.split(".hermes/", 1)[1] for member in tar if member.isfile()}
+    assert names == {"skills/tool/scripts/new.py", "cache/web/.git/page"}
