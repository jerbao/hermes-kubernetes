diff --git a/gateway/platforms/whatsapp_common.py b/gateway/platforms/whatsapp_common.py
index 1a4e90a6..cd18b1a2 100644
--- a/gateway/platforms/whatsapp_common.py
+++ b/gateway/platforms/whatsapp_common.py
@@ -300,6 +300,14 @@ def resolve_whatsapp_bridge_dir() -> Path:
     except OSError:
         pass
     if hermes_home_bridge.exists():
+        # Refresh the source on every resolve (backport of upstream 9edf4b18): a mirror frozen at its first copy
+        # would keep spawning a pre-update bridge. node_modules is the mirror's
+        # own install (re-run by the adapter when package.json changes), so it is left alone.
+        try:
+            shutil.copytree(install_bridge, hermes_home_bridge, dirs_exist_ok=True,
+                            ignore=shutil.ignore_patterns("node_modules"))
+        except (OSError, shutil.Error):
+            pass  # unreadable install tree: the mirror as it stands is still the best runnable copy
         return hermes_home_bridge
     try:
         hermes_home_bridge.parent.mkdir(parents=True, exist_ok=True)
diff --git a/tests/gateway/test_whatsapp_bridge_dir_resolution.py b/tests/gateway/test_whatsapp_bridge_dir_resolution.py
index b473b731..1472c342 100644
--- a/tests/gateway/test_whatsapp_bridge_dir_resolution.py
+++ b/tests/gateway/test_whatsapp_bridge_dir_resolution.py
@@ -58,3 +58,32 @@ def test_readonly_install_mirrors_to_hermes_home(tmp_path, monkeypatch):
     assert (expected / "package.json").exists()
 
 
+
+def test_existing_mirror_is_refreshed_from_the_install_tree_and_keeps_its_deps(tmp_path, monkeypatch):
+    """After an update the read-only install ships new bridge source (e.g. the token proof); a mirror frozen at its
+    first copy would keep spawning the old bridge forever. Source is refreshed; the mirror's node_modules survive."""
+    install_root = tmp_path / "install"
+    install_bridge = install_root / "scripts" / "whatsapp-bridge"
+    _seed_install_tree(install_bridge)
+    (install_bridge / "bridge_auth.js").write_text("// new auth\n")
+    hermes_home = tmp_path / "hermes_home"
+    mirror = hermes_home / "scripts" / "whatsapp-bridge"
+    (mirror / "node_modules" / "dep").mkdir(parents=True)
+    (mirror / "node_modules" / "dep" / "index.js").write_text("// installed\n")
+    (mirror / "bridge.js").write_text("// stale bridge\n")
+
+    monkeypatch.setattr(whatsapp_common, "__file__", str(install_root / "gateway" / "platforms" / "whatsapp_common.py"))
+    monkeypatch.setattr("hermes_constants.get_hermes_home", lambda: hermes_home)
+    _real_touch = Path.touch
+
+    def _fake_touch(self, *a, **kw):
+        if self.name == ".write_test" and install_bridge in self.parents:
+            raise PermissionError("read-only install tree")
+        return _real_touch(self, *a, **kw)
+
+    monkeypatch.setattr(Path, "touch", _fake_touch)
+
+    assert whatsapp_common.resolve_whatsapp_bridge_dir() == mirror
+    assert (mirror / "bridge.js").read_text() == "// bridge\n"
+    assert (mirror / "bridge_auth.js").read_text() == "// new auth\n"
+    assert (mirror / "node_modules" / "dep" / "index.js").read_text() == "// installed\n"
