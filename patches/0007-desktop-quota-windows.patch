+              windows: [
+                { label: '5 hours', used_percent: 54, resets_at: reset },
+                { label: '7 days', used_percent: 8, resets_at: reset }
+              ]
+            }
+          ]
+        }
+      }
+    ]
+  })
+  const { content } = renderPanel()
+  const chip = await content.findByText('1 account')
+  fireEvent.pointerMove(chip, { pointerType: 'mouse' })
