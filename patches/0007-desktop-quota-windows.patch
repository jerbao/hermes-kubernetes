@@ -76,3 +76,38 @@ it('only presents a pool-wide wall when every account is limited, preserving unk
   expect(screen.getByText('10 accounts')).toBeTruthy()
   expect(screen.queryByText(/Limited until|accounts limited/)).toBeNull()
 })
+
+it('shows every reported live window and its reset, including optional model-specific limits', async () => {
+  vi.spyOn(Date, 'now').mockReturnValue(NOW)
+  const entry = account(0, false)
+  entry.windows = [
+    { label: '5 hours', used_percent: 54, resets_at: iso(90) },
+    { label: '7 days', used_percent: 8, resets_at: iso(1440) },
+    { label: 'Fable · 7 days', used_percent: 25, resets_at: iso(1440), scope: 'model' },
+    { label: 'Expired', used_percent: 100, resets_at: iso(-10) }
+  ]
+  render(view(provider([entry])))
+  fireEvent.pointerMove(screen.getByText('1 account'), { pointerType: 'mouse' })
+  const tip = await screen.findByRole('tooltip')
+
+  expect(tip.querySelectorAll('[data-quota-window]')).toHaveLength(3)
+  expect(tip.textContent).toContain('5 hours: 46% left, resets ')
+  expect(tip.textContent).toContain('7 days: 92% left, resets ')
+  expect(tip.textContent).toContain('Fable · 7 days: 75% left, resets ')
+  expect(tip.textContent).not.toContain('Expired')
+})
+
+it('does not synthesize missing windows and keeps unavailable accounts explicit', async () => {
+  vi.spyOn(Date, 'now').mockReturnValue(NOW)
+  const entry = account(0, false)
+  entry.windows = [{ label: '5 hours', used_percent: 12, resets_at: null }]
+  const unavailable = { ...account(1, false), state: 'unknown' as const, windows: [] }
+  render(view(provider([entry, unavailable])))
+  fireEvent.pointerMove(screen.getByText('2 accounts'), { pointerType: 'mouse' })
+  const tip = await screen.findByRole('tooltip')
+
+  expect(tip.querySelectorAll('[data-quota-window]')).toHaveLength(1)
+  expect(tip.textContent).toContain('5 hours: 88% left')
+  expect(tip.textContent).toContain('Usage unavailable')
+  expect(tip.textContent).not.toMatch(/7 days|Fable|resets/)
+})
