+# ---------------------------------------------------------------------------
+# tools.tool_search.keep — tools pinned to the visible array, never deferred
+# ---------------------------------------------------------------------------
+
+
+class TestKeepTools:
+    @staticmethod
+    def _register(name, toolset):
+        from tools.registry import registry
+
+        registry.register(
+            name=name,
+            handler=lambda args, task_id=None, **kw: json.dumps({"ok": True}),
+            schema=_td(name, f"desc for {name}", {"q": {"type": "string"}})["function"],
+            toolset=toolset,
+        )
+
+    @pytest.mark.parametrize("raw", [{}, {"keep": None}, {"enabled": "on"}])
+    def test_from_raw_keep_absent_is_empty_frozenset(self, raw):
+        """Derruba: from_raw que deixa keep_tools None/set/outro tipo quando 'keep' falta."""
+        from tools.tool_search import ToolSearchConfig
+
+        assert ToolSearchConfig.from_raw(raw).keep_tools == frozenset()
+        assert isinstance(ToolSearchConfig.from_raw(raw).keep_tools, frozenset)
+        assert ToolSearchConfig.from_raw(None).keep_tools == frozenset()
+
+    def test_from_raw_keep_list_is_stripped_and_drops_blanks(self):
+        """Derruba: from_raw ignorar 'keep' (ou nao dar strip / nao descartar vazios)."""
+        from tools.tool_search import ToolSearchConfig
+
+        cfg = ToolSearchConfig.from_raw({"keep": [" my_plugin_tool ", "", "  ", "mcp_x_y", "my_plugin_tool"]})
+        assert cfg.keep_tools == frozenset({"my_plugin_tool", "mcp_x_y"})
+        assert isinstance(cfg.keep_tools, frozenset)
+
+    @pytest.mark.parametrize("scalar", ["my_plugin_tool", 7, True])
+    def test_from_raw_keep_scalar_is_empty_not_iterated_chars(self, scalar):
+        """Derruba: iterar a string 'keep: my_plugin_tool' como letras soltas."""
+        from tools.tool_search import ToolSearchConfig
+
+        assert ToolSearchConfig.from_raw({"keep": scalar}).keep_tools == frozenset()
+
+    def test_keep_default_is_registered_empty_list(self):
+        """O default em DEFAULT_CONFIG existe (para `hermes config set`) e e []."""
+        from hermes_cli.config_defaults import DEFAULT_CONFIG
+
+        assert DEFAULT_CONFIG["tools"]["tool_search"]["keep"] == []
+
+    @pytest.mark.parametrize("toolset", ["keepprobeplugin", "mcp-keep-probe"])
+    def test_plugin_and_mcp_tool_deferrable_without_keep_not_with(self, toolset):
+        """Derruba: remover `or name in keep_tools` em is_deferrable_tool_name."""
+        from tools.tool_search import is_deferrable_tool_name
+
+        name = f"keep_probe_{toolset.replace('-', '_')}"
+        self._register(name, toolset)
+        assert is_deferrable_tool_name(name)
+        assert is_deferrable_tool_name(name, None, frozenset({"outro"}))
+        assert not is_deferrable_tool_name(name, None, frozenset({name}))
+
+    def test_keep_beats_an_explicit_defer_entry(self):
+        """keep vence defer: ferramenta nas duas listas fica visivel."""
+        from tools.tool_search import is_deferrable_tool_name
+
+        assert is_deferrable_tool_name("terminal", frozenset({"terminal"}))
+        assert not is_deferrable_tool_name("terminal", frozenset({"terminal"}), frozenset({"terminal"}))
+
+    def test_classify_tools_honours_keep(self):
+        """Derruba: classify_tools que nao repassa keep_tools."""
+        from tools.tool_search import classify_tools
+
+        self._register("keep_cls_a", "keepclsplugin")
+        self._register("keep_cls_b", "keepclsplugin")
+        defs = [_td("keep_cls_a"), _td("keep_cls_b")]
+        visible, deferrable = classify_tools(defs, None, frozenset({"keep_cls_a"}))
+        assert [td["function"]["name"] for td in visible] == ["keep_cls_a"]
+        assert [td["function"]["name"] for td in deferrable] == ["keep_cls_b"]
+
+    def test_assemble_keeps_pinned_plugin_tool_visible_with_full_schema(self):
+        """Derruba: assemble_tool_defs nao passar keep_tools a classify_tools; schema
+        da ferramenta pinada vem completo, as demais de plugin ficam atras do bridge."""
+        from tools.tool_search import BRIDGE_TOOL_NAMES, ToolSearchConfig, assemble_tool_defs
+
+        pinned = "keep_asm_pinned"
+        others = ["keep_asm_other_1", "keep_asm_other_2"]
+        for n in [pinned, *others]:
+            self._register(n, "keepasmplugin")
+        defs = [_td("terminal", "Run a command")] + [
+            _td(n, f"desc for {n}", {"q": {"type": "string"}}) for n in [pinned, *others]
+        ]
+
+        base = assemble_tool_defs(defs, context_length=200_000,
+                                  config=ToolSearchConfig.from_raw({"enabled": "on"}))
+        assert base.activated
+        assert pinned not in {t["function"]["name"] for t in base.tool_defs}  # controle
+
+        out = assemble_tool_defs(defs, context_length=200_000,
+                                 config=ToolSearchConfig.from_raw({"enabled": "on", "keep": [pinned]}))
+        by_name = {t["function"]["name"]: t for t in out.tool_defs}
+        assert out.activated
+        assert by_name[pinned] == defs[1]  # schema completo, intacto
+        assert by_name[pinned]["function"]["parameters"]["properties"] == {"q": {"type": "string"}}
+        assert not set(others) & set(by_name)
+        assert BRIDGE_TOOL_NAMES <= set(by_name)
+
+    def test_assemble_with_every_deferrable_pinned_does_not_activate(self):
+        """Tudo pinado → nada a esconder → sem bridge (enabled=on, sem conectores)."""
+        from tools.tool_search import ToolSearchConfig, assemble_tool_defs
+
+        self._register("keep_all_pinned", "keepallplugin")
+        defs = [_td("terminal", "Run"), _td("keep_all_pinned")]
+        out = assemble_tool_defs(defs, context_length=200_000,
+                                 config=ToolSearchConfig.from_raw({"enabled": "on", "keep": ["keep_all_pinned"]}))
+        assert not out.activated
+        assert {t["function"]["name"] for t in out.tool_defs} == {"terminal", "keep_all_pinned"}
+
+    def test_bridge_tool_call_of_kept_tool_is_refused_use_directly(self, monkeypatch):
+        """Derruba: resolve_underlying_call sem keep_tools (aceitaria a chamada pelo bridge)."""
+        from tools import tool_search
+        from tools.tool_search import ToolSearchConfig, resolve_underlying_call
+        from tools.tool_search_validation import not_deferrable_error
+
+        self._register("keep_call_pinned", "keepcallplugin")
+        self._register("keep_call_free", "keepcallplugin")
+        monkeypatch.setattr(
+            tool_search, "load_config_readonly",
+            lambda: ToolSearchConfig.from_raw({"keep": ["keep_call_pinned"]}),
+        )
+
+        name, args, err = resolve_underlying_call({"name": "keep_call_pinned", "arguments": {"q": "x"}})
+        assert (name, args) == (None, {})
+        assert err == not_deferrable_error("keep_call_pinned")
+        assert "Call it directly" in err
+
+        # controle: a nao-pinada do mesmo toolset continua passando pelo bridge
+        assert resolve_underlying_call({"name": "keep_call_free", "arguments": {"q": "x"}}) == (
+            "keep_call_free", {"q": "x"}, None)
+
+    def test_scoped_deferrable_names_excludes_kept(self, monkeypatch):
+        """Derruba: scoped_deferrable_names sem keep_tools (a pinada seria alcancavel pelo bridge)."""
+        from tools import tool_search
+        from tools.tool_search import ToolSearchConfig, scoped_deferrable_names
+
+        self._register("keep_scope_pinned", "keepscopeplugin")
+        self._register("keep_scope_free", "keepscopeplugin")
+        monkeypatch.setattr(
+            tool_search, "load_config_readonly",
+            lambda: ToolSearchConfig.from_raw({"keep": ["keep_scope_pinned"]}),
+        )
+        names = scoped_deferrable_names([_td("keep_scope_pinned"), _td("keep_scope_free")])
+        assert names == frozenset({"keep_scope_free"})
