@@ -1635,6 +1635,24 @@ class SessionDB(
             row = self._conn.execute("SELECT value FROM state_meta WHERE key = ?", (key,)).fetchone()
         return None if row is None else row[0]
 
+    def get_meta_many(self, keys: List[str]) -> Dict[str, str]:
+        """Read a committed set of metadata keys in one read snapshot.
+
+        Unlike ``get_meta``, this uses the pooled read path so read-only status
+        consumers do not queue behind the writer mutex in WAL mode. Keep
+        ``get_meta`` on the writer connection for callers that must observe
+        uncommitted same-connection progress (notably FTS rebuild bookkeeping).
+        """
+        unique_keys = list(dict.fromkeys(key for key in keys if key))
+        if not unique_keys:
+            return {}
+        placeholders = ", ".join("?" for _ in unique_keys)
+        rows = self._read_all(
+            f"SELECT key, value FROM state_meta WHERE key IN ({placeholders})",
+            tuple(unique_keys),
+        )
+        return {str(row["key"]): str(row["value"]) for row in rows}
+
     def set_meta(self, key: str, value: str, *, cursor: Optional[sqlite3.Cursor] = None) -> None:
         """Upsert state_meta[key]; with ``cursor`` the write is inline (the caller already holds a
         transaction — nesting BEGIN IMMEDIATE would deadlock)."""
