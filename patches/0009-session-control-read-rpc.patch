+def _goal_state_waiting_status(session_id: str, state: "GoalState") -> tuple[bool, bool]:
+    """Read a goal barrier without constructing a manager or persisting lazy cleanup.
+
+    Status snapshots use this after reading the goal through SessionDB's WAL read
+    pool. The normal manager path remains responsible for clearing satisfied
+    barriers when a goal is actively evaluated.
+    """
+    if state.waiting_on_session is not None:
+        still = _session_waiting(state.waiting_on_session)
+    elif state.waiting_on_pid is not None:
+        still = _pid_alive(state.waiting_on_pid)
+    elif state.waiting_until:
+        still = time.time() < state.waiting_until
+        if still and state.waiting_on_delegations > 0:
+            still = count_active_delegations(session_id) >= state.waiting_on_delegations
+    else:
+        return False, False
+    expired = bool(
+        still
+        and state.waiting_since
+        and state.waiting_until == 0.0
+        and time.time() - state.waiting_since > _MAX_BARRIER_WAIT_S
+    )
+    return still and not expired, expired
+
+
+def goal_state_is_waiting(session_id: str, state: "GoalState") -> bool:
+    """Read a goal barrier without constructing a manager or persisting lazy cleanup."""
+    return _goal_state_waiting_status(session_id, state)[0]
+
+
