+        assert goal_blocks_loop_tick("snapshot", state=state) is True
+        monkeypatch.setattr(goals, "count_active_delegations", lambda _sid: 2)
+        assert goal_blocks_loop_tick("snapshot", state=state) is False
+
+        state.waiting_until = time.time() - 1
+        state.waiting_on_delegations = 0
+        assert goal_blocks_loop_tick("snapshot", state=state) is True
+
+        state.waiting_until = 0
+        state.waiting_on_pid = 2_000_000_000
+        state.waiting_since = time.time() - goals._MAX_BARRIER_WAIT_S - 1
+        monkeypatch.setattr(goals, "_pid_alive", lambda _pid: True)
