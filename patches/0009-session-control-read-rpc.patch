+
+        state = GoalState(goal="finish it", status="active", waiting_on_session="worker")
+        monkeypatch.setattr(goals, "_session_waiting", lambda _sid: True)
+        assert goal_blocks_loop_tick("snapshot", state=state) is False
+
+        monkeypatch.setattr(goals, "_session_waiting", lambda _sid: False)
+        assert goal_blocks_loop_tick("snapshot", state=state) is True
+
+        state.waiting_on_session = None
+        state.waiting_until = time.time() + 60
+        state.waiting_on_delegations = 2
