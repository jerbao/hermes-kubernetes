+# This personal distribution runs Bot Screen on the Ubuntu terminal VM via the
+# native SSH placement. Keep the tools; the VM owns XFCE/VNC and browser state.
+# The container still contains PM's Chromium for native headless browser tools.
+
+# Keep the Docker client used by native terminal backends; no engine or socket
+# is installed. Verify RPM signatures using Docker's official repository.
+ARG DOCKER_CLI_VERSION=29.8.2-1.el10
+RUN curl -fsSL --retry 3 -o /etc/yum.repos.d/docker-ce.repo \
+      https://download.docker.com/linux/rhel/docker-ce.repo && \
+    microdnf install -y --setopt=install_weak_deps=0 "docker-ce-cli-${DOCKER_CLI_VERSION}" && \
+    microdnf clean all && docker --version
 
