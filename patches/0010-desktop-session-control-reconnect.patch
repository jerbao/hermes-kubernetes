+/** Refreshes a session after the gateway reconnects, coalescing that reconnect edge. */
+export function refreshSessionControlAfterReconnect(
+  sessionId: string
+): Promise<SessionControlEntry | undefined> {
+  if (!sessionId) {
+    return Promise.resolve(undefined)
+  }
+
+  const pending = reconnectReads.get(sessionId)
+
+  if (pending) {
+    return pending
+  }
+
+  const refresh = refreshSessionControl(sessionId, { background: true })
+  reconnectReads.set(sessionId, refresh)
+  void refresh.finally(() => {
+    if (reconnectReads.get(sessionId) === refresh) {
+      reconnectReads.delete(sessionId)
+    }
+  })
+
+  return refresh
+}
