+    @pytest.mark.parametrize("traced", [False, True])
+    def test_wrapper_keeps_user_trace_status_and_cwd(self, tmp_path, traced):
+        # Cobre: wrapper com/sem xtrace; trace interno tardio não pode virar cwd %s.
+        bash = shutil.which("bash")
+        if bash is None:
+            pytest.skip("bash required")
+        cwd = tmp_path / "cwd with spaces"
+        cwd.mkdir()
+        env = _TestableEnv(cwd=str(tmp_path))
+        command = ("set -x; " if traced else "") + (
+            f"cd {shlex.quote(str(cwd))}; echo user-output; (exit 7)"
+        )
+        proc = subprocess.run(
+            [bash, "-c", env._wrap_command(command, env.cwd)],
+            capture_output=True, text=True, timeout=10, check=False,
+        )
+        result = {"output": proc.stdout + proc.stderr}
+        env._extract_cwd_from_output(result)
+
+        assert proc.returncode == 7
+        assert env._cwd_marker not in proc.stderr
+        assert env._cwd_marker not in result["output"]
+        assert result["cwd_observed"] is True
+        assert result["cwd"] == env.cwd == str(cwd.resolve())
+        assert result["output"].startswith("user-output\n")
+        if traced:
+            assert "+ echo user-output" in proc.stderr
+            assert "+ echo user-output" in result["output"]
+        else:
+            assert proc.stderr == ""
+            assert result["output"] == "user-output\n"
+
+    def test_bootstrap_marker_survives_reordered_xtrace(self, tmp_path):
+        # Cobre: bootstrap sob -x; emissão interna não deve contaminar o parser real.
+        bash = shutil.which("bash")
+        if bash is None:
+            pytest.skip("bash required")
+        env = _TestableEnv(cwd=str(tmp_path))
+        env._snapshot_path = str(tmp_path / "snapshot.sh")
+        script = _snapshot_bootstrap_script(
+            excluded_names=(), **env._snapshot_script_kwargs(env.cwd),
+        )
+        proc = subprocess.run(
+            [bash, "-x", "-c", script], capture_output=True, text=True, timeout=10, check=False,
+        )
+        result = {"output": proc.stdout + proc.stderr}
+        env._extract_cwd_from_output(result)
+
+        assert proc.returncode == 0, proc.stderr
+        assert env._cwd_marker not in proc.stderr
+        assert env._cwd_marker not in result["output"]
+        assert result["cwd_observed"] is True
+        assert result["cwd"] == env.cwd == str(tmp_path.resolve())
+
