+def _catalog_stage(name, operation, *args):
+    """Name expensive discovery stages without logging configuration or skill contents."""
+    started = time.monotonic()
+    try:
+        return operation(*args)
+    finally:
+        elapsed = time.monotonic() - started
+        if elapsed >= 0.25:
+            logger.info("commands.catalog stage=%s elapsed_ms=%d", name, elapsed * 1000)
+
+
