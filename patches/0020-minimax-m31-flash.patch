diff --git a/tests/plugins/model_providers/test_minimax_m31_flash.py b/tests/plugins/model_providers/test_minimax_m31_flash.py
new file mode 100644
--- /dev/null
+++ b/tests/plugins/model_providers/test_minimax_m31_flash.py
@@ -0,0 +1,107 @@
+"""MiniMax-M3.1-Flash: catalog entry, 1M context, and OpenAI-route reasoning extras.
+
+MiniMax-M3.1-Flash rejects a disabled-thinking request (it 400s), so it must be
+listed ahead of M3 in every MiniMax catalog, must resolve to a 1M context
+window, must never be sent ``thinking: disabled`` on the OpenAI route, and must
+never be sent ``reasoning_effort: "none"`` through the custom profile (it gets
+its lowest level instead). M3 keeps its previous behaviour in all four.
+
+Adapted from upstream PR #141412; only the discovery/import order differs
+(``model_tools`` before ``providers``, mirroring the sibling profile tests).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+
+@pytest.fixture
+def minimax_profile():
+    """The registered ``minimax`` profile.
+
+    ``model_tools`` is imported before ``providers`` so plugin discovery has
+    already run when the profile is looked up (same order as the sibling
+    ``tests/plugins/model_providers/`` tests).
+    """
+    import model_tools
+    import providers
+
+    profile = providers.get_provider_profile("minimax")
+    assert profile is not None, "minimax provider profile must be registered"
+    return profile
+
+
+@pytest.fixture
+def custom_profile():
+    """The registered ``custom`` profile (any OpenAI-compatible relay)."""
+    import model_tools
+    import providers
+
+    profile = providers.get_provider_profile("custom")
+    assert profile is not None, "custom provider profile must be registered"
+    return profile
+
+
+@pytest.mark.parametrize("provider", ["minimax", "minimax-cn", "minimax-oauth"])
+def test_catalog_lists_m31_flash_first(provider):
+    """M3.1-Flash heads every MiniMax catalog; M3 stays right behind it."""
+    from hermes_cli.models_catalog_static import _PROVIDER_MODELS
+
+    assert _PROVIDER_MODELS[provider][:2] == ["MiniMax-M3.1-Flash", "MiniMax-M3"]
+
+
+def test_context_length_is_1m():
+    """M3.1-Flash gets the 1M window (M3's), not the 204,800 M2.x default."""
+    from agent.model_metadata import get_model_context_length
+
+    assert get_model_context_length("MiniMax-M3.1-Flash", provider="minimax") == 1_000_000
+
+
+@pytest.mark.parametrize("model", ["MiniMax-M3.1-Flash", "minimax/MiniMax-M3.1-Flash"])
+def test_openai_route_never_disables_thinking(minimax_profile, model):
+    """M3.1 keeps thinking on the OpenAI route: ``adaptive``, never ``disabled``."""
+    extra, _top = minimax_profile.build_api_kwargs_extras(
+        reasoning_config={"enabled": False},
+        model=model,
+        base_url="https://api.minimax.io/v1",
+    )
+    assert extra == {"reasoning_split": True, "thinking": {"type": "adaptive"}}
+
+
+def test_openai_route_still_disables_thinking_for_m3(minimax_profile):
+    """M3 keeps its ``thinking: disabled`` opt-out on the OpenAI route."""
+    extra, _top = minimax_profile.build_api_kwargs_extras(
+        reasoning_config={"enabled": False},
+        model="MiniMax-M3",
+        base_url="https://api.minimax.io/v1",
+    )
+    assert extra["thinking"] == {"type": "disabled"}
+
+
+@pytest.mark.parametrize(
+    "reasoning_config",
+    [{"enabled": False}, {"enabled": True, "effort": "none"}],
+)
+@pytest.mark.parametrize("model", ["MiniMax-M3.1-Flash", "minimax/MiniMax-M3.1-Flash"])
+def test_custom_route_never_sends_effort_none(custom_profile, reasoning_config, model):
+    """M3.1 is sent ``low`` (its lowest level) instead of ``none`` on the custom route."""
+    _extra, top = custom_profile.build_api_kwargs_extras(
+        reasoning_config=reasoning_config,
+        model=model,
+        base_url="https://api.minimaxi.com/v1",
+    )
+    assert top == {"reasoning_effort": "low"}
+
+
+@pytest.mark.parametrize(
+    "reasoning_config",
+    [{"enabled": False}, {"enabled": True, "effort": "none"}],
+)
+def test_custom_route_still_sends_effort_none_for_m3(custom_profile, reasoning_config):
+    """M3 keeps the ``none`` opt-out on the custom route."""
+    _extra, top = custom_profile.build_api_kwargs_extras(
+        reasoning_config=reasoning_config,
+        model="MiniMax-M3",
+        base_url="https://api.minimaxi.com/v1",
+    )
+    assert top == {"reasoning_effort": "none"}
