@@ -0,0 +1,34 @@
+"""Operator-configured stdio executor, shared by probes and live discovery."""
+import json
+
+
+def stdio_executor():
+    from hermes_cli.config import load_config_readonly
+    executor = load_config_readonly().get("mcp", {}).get("stdio_executor")
+    if executor is None:
+        return None
+    if not isinstance(executor, dict) or not isinstance(executor.get("command"), str) or not executor["command"]:
+        raise ValueError("mcp.stdio_executor requires a command")
+    if not isinstance(executor.get("args", []), list) or not all(isinstance(x, str) for x in executor.get("args", [])):
+        raise ValueError("mcp.stdio_executor.args must be a list of strings")
+    return executor
+
+
+def execution_parameters(executor, name, config, command, args, env, cwd):
+    """Keep the original definition in YAML; pass each scoped invocation privately."""
+    from hermes_constants import get_hermes_home, get_default_hermes_root
+    home = get_hermes_home().resolve()
+    root = get_default_hermes_root().resolve()
+    # Host paths describe Hermes's container, not the remote executor. Explicit
+    # server env values still win; credentials already passed the native filter.
+    remote_env = {k: v for k, v in env.items()
+                  if k not in {"PATH", "HOME", "PWD", "VIRTUAL_ENV", "PYTHONPATH"}
+                  and not k.startswith(("XDG_", "HERMES_"))}
+    remote_env.update(config.get("env") or {})
+    definition = {"command": command, "args": args, "env": remote_env}
+    if config.get("cwd"):
+        definition["cwd"] = config["cwd"]
+    child_env = dict(env)
+    child_env["HERMES_MCP_EXECUTION"] = json.dumps({"server": name, "definition": definition,
+                                                  "state_home": str(home), "ssh_home": str(root)})
+    return executor["command"], executor.get("args", []), child_env, None
