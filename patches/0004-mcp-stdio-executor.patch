@@ -0,0 +1,65 @@
+"""The native Desktop MCP RPCs keep definitions editable under remote execution."""
+import json
+from contextlib import contextmanager
+from unittest.mock import patch
+
+import pytest
+import hermes_yaml as yaml
+
+
+def test_desktop_add_edit_credentials_and_remove_keep_the_original_definition(tmp_path, monkeypatch):
+    from tui_gateway import server
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    from tools.mcp_tool_transport import _stdio_launch
+    from tools.mcp_tool_executor import stdio_executor, execution_parameters
+
+    root = tmp_path / 'home'
+    profile = root / 'profiles/work'
+    profile.mkdir(parents=True)
+    monkeypatch.setenv('HERMES_HOME', str(root))
+    executor = {'command': '/usr/bin/python3', 'args': ['executor.py', '--execution']}
+    @contextmanager
+    def hermes_home_override(home):
+        token = set_hermes_home_override(home)
+        try:
+            yield
+        finally:
+            reset_hermes_home_override(token)
+    (profile / 'config.yaml').write_text(yaml.safe_dump({'mcp': {'stdio_executor': executor}}))
+    def call(method, params):
+        response = server._methods[method](1, {'profile': 'work', **params})
+        assert 'error' not in response, response
+        return response['result']
+
+    definition = {'command': 'npx', 'args': ['-y', 'fixture-mcp@1.0.0'], 'enabled': True}
+    assert call('mcp.servers.add', {'name': 'fixture', 'config': definition})['ok']
+    assert call('mcp.servers.set_api_key', {'name': 'fixture', 'value': 'scoped-secret'})['ok']
+    written = yaml.safe_load((profile / 'config.yaml').read_text())['mcp_servers']['fixture']
+    assert written['command'] == 'npx'
+    assert written['args'] == definition['args']
+    with hermes_home_override(profile):
+        resolved = {**written, 'env': {'MCP_FIXTURE_API_KEY': 'scoped-secret'}}
+        with patch('tools.mcp_tool_config._resolve_stdio_command', side_effect=AssertionError('must not install tools in Hermes')):
+            command, env, cwd = _stdio_launch(resolved)
+        wrapped, args, child_env, cwd = execution_parameters(stdio_executor(), 'fixture', resolved,
+                                                            command, resolved['args'], env, cwd)
+        envelope = json.loads(child_env['HERMES_MCP_EXECUTION'])
+        assert envelope['definition']['command'] == 'npx'
+        assert envelope['definition']['env']['MCP_FIXTURE_API_KEY'] == 'scoped-secret'
+        assert envelope['state_home'] == str(profile)
+        assert envelope['ssh_home'] == str(root)
+        assert wrapped == executor['command']
+        assert 'scoped-secret' not in str(args)
+    assert call('mcp.servers.remove', {'name': 'fixture'})['removed']
+    assert 'fixture' not in yaml.safe_load((profile / 'config.yaml').read_text()).get('mcp_servers', {})
+    assert not (root / 'config.yaml').exists()
+
+
+@pytest.mark.asyncio
+async def test_remote_execution_checks_the_original_package_without_using_local_cache(monkeypatch):
+    from tools.mcp_tool import _preflight_stdio_command
+    checked = []
+    monkeypatch.setattr('tools.osv_check.check_package_for_malware', lambda c, a: checked.append((c, a)))
+    with patch('tools.mcp_tool._npx_cached_bin', side_effect=AssertionError('host cache is not remote code')):
+        assert await _preflight_stdio_command('fixture', 'npx', ['fixture@1.0'], remote=True) == ('npx', ['fixture@1.0'])
+    assert checked == [('npx', ['fixture@1.0'])]
