+"""The desktop MCP catalog RPC exposes the transport kind, not an object repr."""
+
+from types import SimpleNamespace
+
+import pytest
+
+import tui_gateway.server as server
+
+
+@pytest.fixture
+def hermes_root(tmp_path, monkeypatch):
+    root = tmp_path / "hermes_home"
+    root.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    from hermes_constants import get_hermes_home_override
+
+    assert get_hermes_home_override() is None
+    return root
+
+
+def _catalog_rpc():
+    response = server._methods["mcp.catalog"](1, {})
+    assert "error" not in response, response.get("error")
+    return response["result"]["servers"]
+
+
+def test_catalog_rpc_normalizes_http_and_stdio_transport(hermes_root, monkeypatch):
+    from hermes_cli import mcp_catalog
+
+    manifest_entries = mcp_catalog.list_catalog()
+    manifest_rows = _catalog_rpc()
+    assert {row["name"]: row["transport"] for row in manifest_rows} == {
+        entry.name: entry.transport.type for entry in manifest_entries
+    }
+
+    entries = [
+        SimpleNamespace(name="fixture-http", description="", connector_slug=None,
+                        env_keys=[], transport=SimpleNamespace(type="http")),
+        SimpleNamespace(name="fixture-stdio", description="", connector_slug=None,
+                        env_keys=[], transport=SimpleNamespace(type="stdio")),
+    ]
+    monkeypatch.setattr(mcp_catalog, "list_catalog", lambda: entries)
+    monkeypatch.setattr(mcp_catalog, "is_installed", lambda _name: False)
+    monkeypatch.setattr(mcp_catalog, "is_enabled", lambda _name: False)
+
+    rows = _catalog_rpc()
+
+    assert {row["name"]: row["transport"] for row in rows} == {
+        "fixture-http": "http",
+        "fixture-stdio": "stdio",
+    }
+    assert all("TransportSpec" not in row["transport"] for row in rows)
