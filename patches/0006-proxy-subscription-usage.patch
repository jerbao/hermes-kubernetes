index 00000000..5ff6a975
--- /dev/null
+++ b/tests/hermes_cli/test_proxy_subscription_usage.py
@@ -0,0 +1,16 @@
+"""The distribution hook augments custom rows without replacing native telemetry."""
+import sys
+import types
+from unittest.mock import patch
+
+
+def test_custom_provider_usage_hook():
+    from hermes_cli.inventory import _apply_usage
+
+    rows = [{"slug": "proxy-codex", "is_user_defined": True}]
+    module = types.ModuleType("hermes_kubernetes.quota.inventory")
+    module.apply_usage = lambda values: values[0].update(usage={"accounts": []})
+    with patch.dict(sys.modules, {module.__name__: module}), \
+         patch("hermes_cli.auth.read_credential_pool", return_value={}):
+        _apply_usage(rows)
+    assert rows[0]["usage"] == {"accounts": []}
