+def _build_marker(ttl: str, native_anthropic: bool = False) -> dict[str, str]:
+    """Build a cache_control marker dict for the given TTL ('5m' or '1h').
+
+    Native Anthropic wire writes 5m out: a bare marker is promoted to 1h by proxies
+    (CLIProxyAPI) that only keep a caller-written ttl. Other routes (Alibaba family)
+    reject a ttl key, so they keep the bare marker.
+    """
+    if ttl == "1h":
+        return {"type": "ephemeral", "ttl": "1h"}
+    return {"type": "ephemeral", "ttl": "5m"} if native_anthropic else {"type": "ephemeral"}
 
 
