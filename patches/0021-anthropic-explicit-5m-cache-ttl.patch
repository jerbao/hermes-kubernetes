+class TestNativeExplicit5m:
+    """Native Anthropic wire must carry ttl "5m" explicitly (proxies promote bare markers to 1h)."""
+
+    def test_marker_native_5m_is_explicit(self):
+        assert _build_marker("5m", native_anthropic=True) == {"type": "ephemeral", "ttl": "5m"}
+        assert _build_marker("5m") == {"type": "ephemeral"}
+
+    def test_apply_native_5m_writes_ttl(self):
