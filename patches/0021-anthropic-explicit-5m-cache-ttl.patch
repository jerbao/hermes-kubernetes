+        out = apply_anthropic_cache_control(
+            [{"role": "system", "content": "s"}, {"role": "user", "content": "u"}],
+            cache_ttl="5m", native_anthropic=True)
+        assert out[-1]["content"][0]["cache_control"] == {"type": "ephemeral", "ttl": "5m"}
