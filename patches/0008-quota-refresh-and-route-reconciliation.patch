+
+export async function requestModelUsage({ gateway, profile, request }: ModelUsageRequest): Promise<ModelUsageResult> {
+  const dispatch = request ?? (gateway ? gateway.request.bind(gateway) : null)
+
+  if (!dispatch) {
+    return { providers: {} }
+  }
+
+  const params: Record<string, unknown> = {}
+  const profileKey = (profile ?? '').trim()
+
+  if (profileKey) {
+    params.profile = profileKey
+  }
+
+  return dispatch<ModelUsageResult>('model.usage', params)
+}
