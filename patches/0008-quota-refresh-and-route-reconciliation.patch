+/** Resolve a stale provider only when the exact current model has one
+ * configured catalog owner. The current row may contain a visibility-only
+ * injected model (Hermes marks it with `injected_current_model`); that row is
+ * not ownership evidence. Duplicate ids remain ambiguous and keep their route.
+ */
+export function uniqueConfiguredModelProvider(
+  providers: readonly ModelOptionProvider[] | null | undefined,
+  currentProvider: string,
+  model: string
+): string | undefined {
+  if (!providers || !currentProvider || !model) return undefined
+
+  const current = findCatalogProvider(providers, currentProvider)
+  if (!current || current.injected_current_model !== model) return undefined
+
+  const owners = providers.filter(
+    provider => provider.models?.includes(model) && provider.injected_current_model !== model
+  )
+
+  return owners.length === 1 && owners[0].slug !== current.slug ? owners[0].slug : undefined
+}
