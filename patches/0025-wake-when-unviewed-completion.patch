+# --- wake_when_unviewed: a completion that must run a turn even with no viewer -------------------
+
+async def _admit_process(runner, authority, ref, name, wake):
+    """Admit a process completion like ``_deliver`` does, with the ``wake_when_unviewed`` metadata."""
+    import json
+    from gateway.platforms.event import MessageEvent
+    live = authority.sessions[ref.session_id]
+    target = _target(runner, authority, ref)
+    metadata = {'gateway_session_key': live.route, 'gateway_session_id': target,
+                'display_kind': 'process_complete', 'display_text': f'Finished: {name}'}
+    if wake:
+        metadata['wake_when_unviewed'] = True
+    event = MessageEvent(text=f'[finished] RESULT_{name}', source=live.source, internal=True, metadata=metadata)
+    identity = json.dumps(['completion', name, 1700000000.0], separators=(',', ':'))
+    await authority.admit_automation(runner._adapter_for_source(live.source), event, identity)
+    return target
+
+
+@pytest.mark.asyncio
+async def test_wake_flag_completion_without_viewer_runs_a_turn_not_a_note(tmp_path, monkeypatch):
+    """Drops if ``noted_completion`` ignores the descriptor flag: the completion would be a note."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        target = await _admit_process(runner, authority, ref, 'proc_wake', wake=True)
+        seen = _turns(runner, authority, target)
+        await authority._drain(ref)
+        assert [text for text, _ in seen] == ['[finished] RESULT_proc_wake']
+        assert _notes(authority, target) == []
+        assert [r['outcome'] for r in _admissions(authority, ref)] == ['completed']
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_completion_without_wake_flag_stays_a_note(tmp_path, monkeypatch):
+    """Control: same scenario minus the flag is a note and no turn."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        target = await _admit_process(runner, authority, ref, 'proc_plain', wake=False)
+        seen = _turns(runner, authority, target)
+        await authority._drain(ref)
+        assert seen == [] and len(_notes(authority, target)) == 1
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_deliver_notification_with_wake_flag_becomes_a_turn(tmp_path, monkeypatch):
+    """Drops if ``_watch_notification_metadata`` or the descriptor snapshot loses the evt key."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        target = _target(runner, authority, ref)
+        evt = dict(_process_event(authority, ref, target, 'proc_wake'), wake_when_unviewed=True)
+        assert await runner._deliver_completion_notification('[finished] RESULT_proc_wake', evt) is True
+        seen = _turns(runner, authority, target)
+        await authority._drain(ref)
+        # _deliver_completion_notification appends the internal-notification footer to the text.
+        assert len(seen) == 1 and seen[0][0].startswith('[finished] RESULT_proc_wake')
+        assert _notes(authority, target) == []
+        assert [r['outcome'] for r in _admissions(authority, ref)] == ['completed']
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('first_wakes', [True, False], ids=['flag_first', 'flag_second'])
+async def test_completions_with_and_without_wake_flag_do_not_fold(tmp_path, monkeypatch, first_wakes):
+    """Drops if ``_waiting_completion`` stops comparing the flag: a note-only result would be
+    folded into a turn (or the reverse) and the two admissions would collapse into one."""
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        target = _target(runner, authority, ref)
+        for name, wake in (('proc_a', first_wakes), ('proc_b', not first_wakes)):
+            evt = _process_event(authority, ref, target, name)
+            if wake:
+                evt['wake_when_unviewed'] = True
+            assert await runner._deliver_completion_notification(f'[finished] RESULT_{name}', evt) is True
+        assert [r['status'] for r in _admissions(authority, ref)] == ['queued', 'queued']
+    finally:
+        authority.db.close()
