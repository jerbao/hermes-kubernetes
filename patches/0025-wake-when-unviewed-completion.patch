+@pytest.mark.parametrize("wake", [True, False])
+def test_publish_finished_carries_wake_when_unviewed_only_when_set(registry, monkeypatch, wake):
+    """Drops if the completion event loses the flag, or always carries it (key must be absent when unset)."""
+    monkeypatch.setattr(registry, "_write_checkpoint", lambda: None)
+    session = _make_session(sid="proc_wake", exited=True, exit_code=0)
+    session.notify_on_complete = True
+    session.wake_when_unviewed = wake
+
+    registry._publish_finished(session, was_running=True)
+
+    event = registry.completion_queue.get_nowait()
+    assert event["type"] == "completion" and event["session_id"] == "proc_wake"
+    if wake:
+        assert event["wake_when_unviewed"] is True
+    else:
+        assert "wake_when_unviewed" not in event
