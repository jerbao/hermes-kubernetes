diff --git a/tests/gateway/test_whatsapp_bridge_host_env.py b/tests/gateway/test_whatsapp_bridge_host_env.py
new file mode 100644
index 0000000..d181a89
--- /dev/null
+++ b/tests/gateway/test_whatsapp_bridge_host_env.py
@@ -0,0 +1,47 @@
+"""WHATSAPP_BRIDGE_HOST / WHATSAPP_BRIDGE_ALLOWED_HOSTS must reach the Node bridge subprocess.
+
+bridge.js reads both from process.env (listen address + extra accepted Host names). The adapter only
+forwards keys listed in _BRIDGE_PASSTHROUGH_ENV, so dropping them there silently reverts a pod to
+loopback-only. Absent values must be popped so a launch-env value never leaks into another profile.
+"""
+
+import pytest
+
+from gateway.config import PlatformConfig
+
+_KEYS = ("WHATSAPP_BRIDGE_HOST", "WHATSAPP_BRIDGE_ALLOWED_HOSTS")
+
+
+def _bridge_env():
+    from plugins.platforms.whatsapp.adapter import WhatsAppAdapter
+    return WhatsAppAdapter(PlatformConfig(enabled=True, extra={}))._bridge_env()
+
+
+def test_bridge_host_env_is_forwarded(monkeypatch):
+    """Both vars set -> present, verbatim, in the bridge env (dies if the keys leave the passthrough tuple)."""
+    monkeypatch.setenv("WHATSAPP_BRIDGE_HOST", "0.0.0.0")
+    monkeypatch.setenv("WHATSAPP_BRIDGE_ALLOWED_HOSTS", "ponte.nyra.svc, Outro.Svc")
+    env = _bridge_env()
+    assert env["WHATSAPP_BRIDGE_HOST"] == "0.0.0.0"
+    assert env["WHATSAPP_BRIDGE_ALLOWED_HOSTS"] == "ponte.nyra.svc, Outro.Svc"
+
+
+@pytest.mark.parametrize("key", _KEYS)
+def test_each_bridge_host_key_is_forwarded_alone(monkeypatch, key):
+    """One key at a time: removing just one of the two from the tuple is caught."""
+    for k in _KEYS:
+        monkeypatch.delenv(k, raising=False)
+    monkeypatch.setenv(key, "valor-x")
+    env = _bridge_env()
+    assert env[key] == "valor-x"
+    assert [k for k in _KEYS if k in env] == [key]
+
+
+def test_bridge_host_env_absent_is_removed(monkeypatch):
+    """Unset (or empty) -> key not in the bridge env, so the bridge keeps its loopback-only default."""
+    for k in _KEYS:
+        monkeypatch.delenv(k, raising=False)
+    env = _bridge_env()
+    assert not any(k in env for k in _KEYS)
+    monkeypatch.setenv("WHATSAPP_BRIDGE_HOST", "")
+    assert "WHATSAPP_BRIDGE_HOST" not in _bridge_env()
