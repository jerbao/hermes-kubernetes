+++ b/scripts/whatsapp-bridge/bridge.host.test.mjs
@@ -0,0 +1,84 @@
+/**
+ * Integration test for the bridge listen address (WHATSAPP_BRIDGE_HOST) and the extra accepted
+ * Host names (WHATSAPP_BRIDGE_ALLOWED_HOSTS). Unlike the pure-helper tests, this spawns the real
+ * bridge.js (the behaviour lives at module load) with a temp HOME/session, no WhatsApp login, so
+ * /send answers 503 once the Host check passed and 400 when it did not.
+ *
+ * Run: node --test bridge.host.test.mjs
+ */
+
+import { test } from 'node:test';
+import { strict as assert } from 'node:assert';
+import { spawn } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import http from 'node:http';
+import net from 'node:net';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const BRIDGE = path.join(path.dirname(fileURLToPath(import.meta.url)), 'bridge.js');
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+const freePort = () => new Promise((resolve, reject) => {
+  const s = net.createServer();
+  s.once('error', reject);
+  s.listen(0, '127.0.0.1', () => { const { port } = s.address(); s.close(() => resolve(port)); });
+});
+
+// POST /send with an explicit Host header; returns the status or 0 when the connection fails.
+const post = (addr, port, host) => new Promise(resolve => {
+  const req = http.request({ host: addr, port, path: '/send', method: 'POST', headers: { Host: host, 'Content-Type': 'application/json' }, timeout: 3000 },
+    res => { res.resume(); resolve(res.statusCode); });
+  req.on('error', () => resolve(0));
+  req.on('timeout', () => { req.destroy(); resolve(0); });
+  req.end('{}');
+});
+
+async function withBridge(extraEnv, fn) {
+  const home = mkdtempSync(path.join(os.tmpdir(), 'bridge-host-'));
+  const port = await freePort();
+  const env = { PATH: process.env.PATH, HOME: home, HERMES_HOME: home, TMPDIR: home, ...extraEnv };
+  const child = spawn(process.execPath, [BRIDGE, '--port', String(port), '--session', path.join(home, 'session')], { env, stdio: 'ignore' });
+  try {
+    let up = false;
+    for (let i = 0; i < 100 && !up; i += 1) {
+      assert.equal(child.exitCode, null, 'bridge exited before listening');
+      up = (await post('127.0.0.1', port, 'localhost')) !== 0;
+      if (!up) await sleep(200);
+    }
+    assert.ok(up, 'bridge never started listening');
+    return await fn(port);
+  } finally {
+    child.kill('SIGKILL');
+    rmSync(home, { recursive: true, force: true });
+  }
+}
+
+const externalIp = Object.values(os.networkInterfaces()).flat().find(i => i && i.family === 'IPv4' && !i.internal)?.address;
+
+// (a) default: loopback only, loopback Host accepted, foreign Host rejected.
+test('default keeps loopback-only Host check', async () => {
+  await withBridge({}, async port => {
+    assert.equal(await post('127.0.0.1', port, `localhost:${port}`), 503, 'localhost Host must pass the check');
+    assert.equal(await post('127.0.0.1', port, 'x.svc'), 400);
+  });
+});
+
+test('default does not listen on the non-loopback IP', { skip: externalIp ? false : 'no non-loopback IPv4 on this machine' }, async () => {
+  await withBridge({}, async port => {
+    assert.equal(await post(externalIp, port, 'localhost'), 0, 'connection must be refused');
+  });
+});
+
+// (b) opt-in: any interface + extra names (trimmed, case-insensitive, exact match).
+test('WHATSAPP_BRIDGE_HOST=0.0.0.0 + ALLOWED_HOSTS accept only the listed Host names', async () => {
+  const env = { WHATSAPP_BRIDGE_HOST: '0.0.0.0', WHATSAPP_BRIDGE_ALLOWED_HOSTS: 'ponte.nyra.svc, Outro.Svc' };
+  await withBridge(env, async port => {
+    assert.equal(await post('127.0.0.1', port, `ponte.nyra.svc:${port}`), 503);
+    assert.equal(await post('127.0.0.1', port, 'outro.svc'), 503, 'entry is trimmed and lower-cased');
+    assert.equal(await post('127.0.0.1', port, 'maligno.com'), 400);
+    assert.equal(await post('127.0.0.1', port, 'ponte.nyra.svc.evil.com'), 400, 'exact match, not suffix/prefix');
+    if (externalIp) assert.equal(await post(externalIp, port, 'ponte.nyra.svc'), 503, 'reachable on the external IP');
+  });
+});
