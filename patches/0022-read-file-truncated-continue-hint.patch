+#!/usr/bin/env python3
+"""
+Tests for the truncated-read continuation hint.
+
+A read that came back truncated used to be followed by a refusal that said
+nothing about WHERE to continue: the dedup stub ("File unchanged since last
+read") and the hard BLOCKED ("still current. Proceed with your task...")
+both left the model re-reading the same region forever (117 blocks recorded
+in the field). The fix records the continuation offset per (path, offset,
+limit) and appends it to the stub, to the dedup BLOCKED and to the
+consecutive-read BLOCKED.
+
+Run with:  python -m pytest tests/tools/test_file_read_continue_hint.py -v
+"""
+import json
+import os
+import shutil
+import unittest
+from unittest.mock import MagicMock, patch
+
+from tools.file_operations_common import ReadResult
+from tools.file_tools import read_file_tool
+from tools.file_tools_read_tracking import _read_tracker, reset_file_dedup
+
+from tests.tools.test_file_read_guards import _make_safe_tempdir
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+def _make_file_backed_ops():
+    """FileOperations stand-in that serves a page of the REAL file on disk.
+
+    Truncation is therefore decided by the file (total lines vs the requested
+    window), exactly like the shell backend's ``sed -n 'a,bp'`` page, and the
+    payload is the production ``ReadResult``.
+    """
+    fake = MagicMock(env=None)
+
+    def read_file(path, offset=1, limit=2000):
+        with open(path, encoding="utf-8") as handle:
+            lines = handle.read().split("\n")
+        if lines and lines[-1] == "":
+            lines.pop()
+        total_lines = len(lines)
+        end_line = offset + limit - 1
+        page = lines[offset - 1:end_line]
+        truncated = total_lines > end_line
+        return ReadResult(
+            content="".join(line + "\n" for line in page),
+            total_lines=total_lines,
+            file_size=os.path.getsize(path),
+            truncated=truncated,
+            hint=(f"Use offset={end_line + 1} to continue reading "
+                  f"(showing {offset}-{end_line} of {total_lines} lines)")
+            if truncated else None,
+        )
+
+    fake.read_file = read_file
+    return fake
+
+
+class TestTruncatedReadContinueHint(unittest.TestCase):
+    """A refused re-read must name the offset that continues a truncated read."""
+
+    def setUp(self):
+        _read_tracker.clear()
+        self._tmpdir = _make_safe_tempdir("hermes-continue-hint-")
+
+    def tearDown(self):
+        _read_tracker.clear()
+        shutil.rmtree(self._tmpdir, ignore_errors=True)
+
+    def _write_file(self, name, lines):
+        path = os.path.join(self._tmpdir, name)
+        with open(path, "w", encoding="utf-8") as handle:
+            handle.write("".join(line + "\n" for line in lines))
+        return path
+
+    @patch("tools.file_tools._get_file_ops")
+    @patch("tools.tool_output_limits.get_max_lines", return_value=2000)
+    @patch("tools.file_tools._get_max_read_chars", return_value=100_000)
+    def test_line_truncated_read_names_continuation_offset(self, _max_chars, _max_lines, mock_ops):
+        """9000 short lines read with limit=2000 truncates BY LINES: the stub
+        and the BLOCKED that follow must say which offset continues it."""
+        path = self._write_file("lines.txt", [f"line {i}" for i in range(9000)])
+        mock_ops.return_value = _make_file_backed_ops()
+
+        first = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertTrue(first["truncated"])
+        self.assertEqual(first["total_lines"], 9000)
+
+        stub = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertTrue(stub.get("dedup"))
+        self.assertIn("offset=2001", stub["message"])
+
+        blocked = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertIn("BLOCKED", blocked["error"])
+        self.assertIn("offset=2001", blocked["error"])
+
+    @patch("tools.file_tools._get_file_ops")
+    @patch("tools.tool_output_limits.get_max_lines", return_value=2000)
+    @patch("tools.file_tools._get_max_read_chars", return_value=1000)
+    def test_byte_truncated_read_names_continuation_offset(self, _max_chars, _max_lines, mock_ops):
+        """3000 fat lines blow the char budget: the read truncates BY BYTES
+        and reports a next_offset, which the refusals must repeat."""
+        path = self._write_file(
+            "bytes.txt", [f"{i:04d}|" + "z" * 390 for i in range(3000)])
+        mock_ops.return_value = _make_file_backed_ops()
+
+        first = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertTrue(first["truncated"])
+        self.assertEqual(first["truncated_by"], "bytes")
+        next_offset = first["next_offset"]
+        self.assertGreater(next_offset, 1)
+
+        stub = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertTrue(stub.get("dedup"))
+        self.assertIn(f"offset={next_offset}", stub["message"])
+
+        blocked = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertIn("BLOCKED", blocked["error"])
+        self.assertIn(f"offset={next_offset}", blocked["error"])
+
+    @patch("tools.file_tools._get_file_ops")
+    @patch("tools.tool_output_limits.get_max_lines", return_value=2000)
+    @patch("tools.file_tools._get_max_read_chars", return_value=100_000)
+    def test_complete_read_never_names_a_continuation_offset(self, _max_chars, _max_lines, mock_ops):
+        """A short file fits in one page: there is nothing to continue, so the
+        refusals must not invent an offset."""
+        path = self._write_file("short.txt", [f"line {i}" for i in range(50)])
+        mock_ops.return_value = _make_file_backed_ops()
+
+        first = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertNotIn("error", first)
+        self.assertFalse(first.get("truncated"))
+
+        stub = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertTrue(stub.get("dedup"))
+        self.assertNotIn("offset=", stub["message"])
+
+        blocked = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertIn("BLOCKED", blocked["error"])
+        self.assertNotIn("offset=", blocked["error"])
+
+    @patch("tools.file_tools._get_file_ops")
+    @patch("tools.tool_output_limits.get_max_lines", return_value=2000)
+    @patch("tools.file_tools._get_max_read_chars", return_value=100_000)
+    def test_offset_dropped_when_region_stops_truncating(self, _max_chars, _max_lines, mock_ops):
+        """The recorded offset is dropped once the same region is re-read
+        WITHOUT truncating: the later BLOCKED must not point at a stale offset."""
+        path = self._write_file("shrink.txt", [f"line {i}" for i in range(9000)])
+        mock_ops.return_value = _make_file_backed_ops()
+
+        first = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertTrue(first["truncated"])
+
+        # The truncated read recorded an offset, so the first refusal names it.
+        stub = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertTrue(stub.get("dedup"))
+        self.assertIn("offset=2001", stub["message"])
+
+        # The file is rewritten short: the same region no longer truncates.
+        self._write_file("shrink.txt", [f"line {i}" for i in range(50)])
+        second = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertNotIn("error", second)
+        self.assertFalse(second.get("truncated"))
+
+        # The stale offset must be gone from the refusals that follow.
+        stub = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertTrue(stub.get("dedup"))
+        self.assertNotIn("offset=", stub["message"])
+
+        blocked = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+        self.assertIn("BLOCKED", blocked["error"])
+        self.assertNotIn("offset=", blocked["error"])
+
+    @patch("tools.file_tools._get_file_ops")
+    @patch("tools.tool_output_limits.get_max_lines", return_value=2000)
+    @patch("tools.file_tools._get_max_read_chars", return_value=100_000)
+    def test_consecutive_read_block_names_continuation_offset(self, _max_chars, _max_lines, mock_ops):
+        """The "read this exact region N times in a row" BLOCKED also has to
+        name the offset that continues the truncated read."""
+        path = self._write_file("loop.txt", [f"line {i}" for i in range(9000)])
+        mock_ops.return_value = _make_file_backed_ops()
+
+        # Each read is a real one (the compression reset clears the
+        # generation flag), so the consecutive-read guard is what fires.
+        blocked = {}
+        for _ in range(4):
+            result = json.loads(read_file_tool(path, offset=1, limit=2000, task_id="cont"))
+            reset_file_dedup("cont")
+            if "error" in result:
+                blocked = result
+        self.assertIn("BLOCKED", blocked.get("error", ""))
+        self.assertIn("offset=2001", blocked["error"])
+
+
+if __name__ == "__main__":
+    unittest.main()
