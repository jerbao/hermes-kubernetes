@@ -0,0 +1,38 @@
+"""Anthropic auxiliary responses retain native usage for MoA accounting."""
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+
+@pytest.mark.parametrize("cache_read,cache_write", [(0, 0), (30, 40)])
+def test_anthropic_auxiliary_usage_reaches_moa_accounting(cache_read, cache_write):
+    from agent.auxiliary_client import AnthropicAuxiliaryClient
+    from agent.moa_loop import _price_reference_response
+
+    native = SimpleNamespace(
+        id="fixture-response", model="claude-sonnet-4-6", stop_reason="end_turn",
+        content=[SimpleNamespace(type="text", text="advisor response")],
+        usage=SimpleNamespace(input_tokens=100, output_tokens=25,
+                              cache_read_input_tokens=cache_read,
+                              cache_creation_input_tokens=cache_write),
+    )
+    wrapper = AnthropicAuxiliaryClient(SimpleNamespace(), "claude-sonnet-4-6",
+                                      "fixture-key", "https://proxy.example")
+    with patch("agent.anthropic_adapter.create_anthropic_message", return_value=native):
+        response = wrapper.chat.completions.create(
+            model="claude-sonnet-4-6", messages=[{"role": "user", "content": "Advise"}],
+        )
+    pricing = SimpleNamespace(amount_usd=None, status="unknown", source="none")
+    with patch("agent.usage_pricing.estimate_usage_cost", return_value=pricing):
+        usage, *_ = _price_reference_response(
+            response, {"model": "claude-sonnet-4-6"},
+            {"provider": "custom", "api_mode": "anthropic_messages"},
+        )
+    assert response.choices[0].message.content == "advisor response"
+    assert (usage.input_tokens, usage.output_tokens) == (100, 25)
+    assert (usage.cache_read_tokens, usage.cache_write_tokens) == (cache_read, cache_write)
+    # Existing consumers can still read the OpenAI-compatible aliases.
+    assert (response.usage.prompt_tokens, response.usage.completion_tokens) == (100, 25)
+    assert response.usage.total_tokens == 125
+    assert not hasattr(native.usage, "prompt_tokens")
