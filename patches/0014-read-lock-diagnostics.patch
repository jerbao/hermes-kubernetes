diff --git a/tests/hermes_state/test_read_path_diagnostics.py b/tests/hermes_state/test_read_path_diagnostics.py
new file mode 100644
index 00000000..07c19e6d
--- /dev/null
+++ b/tests/hermes_state/test_read_path_diagnostics.py
@@ -0,0 +1,54 @@
+"""Read-only handle locks are distinct from writer locks; fallback causes are observable."""
+
+import logging
+import sqlite3
+import time
+
+import pytest
+
+from hermes_state import SessionDB
+import hermes_state_lock_timing as timing
+
+
+@pytest.fixture
+def db(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    yield db
+    db.close()
+
+
+def test_readonly_handle_does_not_take_writer_lock(db, caplog, monkeypatch):
+    monkeypatch.setattr(timing, "_SLOW_HOLD_S", 0)
+    caplog.set_level(logging.INFO, logger=timing.logger.name)
+    reader = SessionDB(db.db_path, read_only=True)
+    try:
+        with db._lock:
+            assert reader._read_one("SELECT 1")[0] == 1
+        logs = [r.getMessage() for r in caplog.records if "slow-hold" in r.getMessage()]
+        assert any("mode=ro" in line and "instance=" in line for line in logs)
+        assert any("mode=rw" in line and str(db.db_path) in line for line in logs)
+        assert reader._lock._label != db._lock._label
+    finally:
+        reader.close()
+
+
+@pytest.mark.parametrize("reason", ["wal_unconfirmed", "open_backoff", "read_budget_unavailable", "open_failed:OperationalError"])
+def test_writable_read_fallback_reason_is_logged_once(db, monkeypatch, caplog, reason):
+    caplog.set_level(logging.INFO, logger=timing.logger.name)
+    monkeypatch.setattr(db, "_wal_active", reason != "wal_unconfirmed")
+    if reason == "open_backoff":
+        db._read_open_failed_at = time.monotonic()
+    elif reason == "read_budget_unavailable":
+        monkeypatch.setattr(db._read_budget, "acquire", lambda owner: False)
+    elif reason.startswith("open_failed"):
+        def fail(**kwargs):
+            raise sqlite3.OperationalError("test open failure")
+        monkeypatch.setattr(db, "_connect_read_only", fail)
+    assert db._checkout_read_conn() is None
+    # Reset the backoff only for the simulated repeated open failure.
+    if reason.startswith("open_failed"):
+        db._read_open_failed_at = 0
+    assert db._checkout_read_conn() is None
+    logs = [r.getMessage() for r in caplog.records if f"reason={reason}" in r.getMessage()]
+    assert len(logs) == 1
+    assert "mode=rw" in logs[0] and str(db.db_path) in logs[0]
