+"""Approval controls must remain available before the agent is ready (upstream #87429)."""
+
+import threading
+from unittest.mock import Mock
+
+import pytest
+
+from tui_gateway import server
+from tools import approval
+
+
+@pytest.mark.parametrize("state", ["cold", "failed"])
+@pytest.mark.parametrize(
+    "method, operation, extra, value, expected, args, kwargs",
+    [
+        ("pending", "list_gateway_approvals", {}, [], "approvals", ("agent-cold",), {}),
+        ("received", "ack_gateway_approval", {"request_id": "req-1"}, True,
+         "acknowledged", ("agent-cold", "req-1"), {}),
+        ("respond", "resolve_gateway_approval", {"request_id": "req-1", "choice": "once"},
+         1, "resolved", ("agent-cold", "once"), {"resolve_all": False, "request_id": "req-1"}),
+    ],
+)
+def test_approval_controls_do_not_build_or_wait(
+    monkeypatch, state, method, operation, extra, value, expected, args, kwargs,
+):
+    ready = threading.Event()
+    record = {"session_key": "agent-cold", "agent": None, "agent_ready": ready,
+              "agent_error": "build failed" if state == "failed" else None}
+    if state == "failed":
+        ready.set()
+    monkeypatch.setitem(server._sessions, "ui-cold", record)
+    build = Mock(side_effect=AssertionError("approval must not start an agent"))
+    wait = Mock(side_effect=AssertionError("approval must not wait for an agent"))
+    monkeypatch.setattr(server, "_start_agent_build", build)
+    monkeypatch.setattr(server, "_wait_agent", wait)
+    action = Mock(return_value=value)
+    monkeypatch.setattr(approval, operation, action)
+
+    response = server.handle_request({"id": "r1", "method": f"approval.{method}",
+                                      "params": {"session_id": "ui-cold", **extra}})
+
+    assert response["result"] == {expected: value}
+    action.assert_called_once_with(*args, **kwargs)
+    build.assert_not_called()
+    wait.assert_not_called()
+    assert ready.is_set() == (state == "failed")
+
+
+@pytest.mark.parametrize("method", ["pending", "received", "respond"])
+def test_unknown_session_still_rejected(monkeypatch, method):
+    monkeypatch.setattr(server, "_approval_respond_session_fallback", lambda params: None)
+    response = server.handle_request({"id": "r2", "method": f"approval.{method}",
+                                      "params": {"session_id": "unknown-cold-session"}})
+    assert response["error"]["code"] == 4001
